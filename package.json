{
  "name": "@zhafron/opencode-kiro-auth",
  "version": "2.0.0",
  "description": "OpenCode plugin for AWS Kiro (CodeWhisperer) providing access to Claude models",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./provider": {
      "types": "./dist/v2/provider/index.d.ts",
      "import": "./dist/v2/provider/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/fix-esm-imports.mjs",
    "format": "prettier --write 'src/**/*.ts'",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "keywords": [
    "opencode",
    "plugin",
    "kiro",
    "codewhisperer",
    "aws",
    "claude",
    "ai",
    "auth"
  ],
  "author": "tickernelz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tickernelz/opencode-kiro-auth.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@aws/codewhisperer-streaming-client": "^1.0.34",
    "@opencode-ai/plugin": "^1.15.11",
    "@opencode/ai": "2.0.30",
    "@opencode/plugin": "2.0.30",
    "@smithy/node-http-handler": "^4.12.1",
    "effect": "4.0.1",
    "https-proxy-agent": "^7.0.6",
    "libsql": "^0.5.29",
    "proper-lockfile": "^4.1.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "bun-types": "^1.3.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.4.2",
    "prettier-plugin-organize-imports": "^4.1.0",
    "typescript": "^5.7.3"
  },
  "opencode": {
    "type": "plugin",
    "hooks": [
      "auth",
      "event"
    ]
  },
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "lint-staged": {
    "*.ts": [
      "prettier --write"
    ]
  }
}
